<% layout("layouts/boilerplate")%>

<div class="row">
  <div class="col-12 col-md-8 offset-md-2">

    <h3 class="mt-4 text-start"><b><%= listing.title%></b></h3>
    <br>

    <div class="card show-card w-100">
      <img src="<%= listing.image && listing.image.url ? listing.image.url : listing.image %>" class="card-img-top show-img" alt="listing_image">
      <div class="card-body p-3">
        <% if (listing.owner) { %>
          <i>Owned by : <%= listing.owner.username %></i>
        <% } %>
        <p class="mt-2">
          <b>DESCRIPTION:</b> &nbsp;<%= listing.description%><br>
          <b>PRICE:</b> &nbsp; &#8377; <%= listing.price.toLocaleString("en-IN")%><br>
          <b>LOCATION:</b> &nbsp;<%= listing.location%><br>
          <b>COUNTRY:</b> &nbsp;<%= listing.country%><br>
        </p>
      </div>
    </div>

    <br>

    <div class="btns">
      <a href="/listings/<%= listing._id%>/edit" class="btn btn-dark btn-sm btn-md-normal edit-btn">Edit</a>
      <form method="POST" action="/listings/<%= listing._id%>?_method=DELETE" class="d-inline">
        <button class="btn btn-dark btn-sm btn-md-normal del-btn ms-2">Delete</button>
      </form>
    </div>

    <br>
    <hr>

    <% if(currUser) { %>
    <div class="mb-3">
      <h4>Leave a Review</h4>
      <form action="/listings/<%= listing._id%>/reviews" method="POST">
        <div class="mb-3 mt-3 star-rating-row">
          <label class="form-label star-rating-label">Rating</label>
          <input type="range" min="1" max="5" id="ratingRange" name="review[rating]" value="3">
          <div class="star-display" id="starDisplay">
            <span>&#9733;</span>
            <span>&#9733;</span>
            <span>&#9733;</span>
            <span>&#9733;</span>
            <span>&#9733;</span>
          </div>
        </div>

        <script>
          const range = document.getElementById("ratingRange");
          const stars = document.querySelectorAll("#starDisplay span");

          function updateStars(val) {
            stars.forEach((s, i) => {
              s.style.color = i < val ? "#ffc107" : "#ccc";
            });
          }

          updateStars(range.value);
          range.addEventListener("input", () => updateStars(range.value));

          stars.forEach((s, i) => {
            s.addEventListener("mouseover", () => updateStars(i + 1));
            s.addEventListener("mouseleave", () => updateStars(range.value));
            s.addEventListener("click", () => {
              range.value = i + 1;
              updateStars(i + 1);
            });
          });
        </script>

        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"></textarea>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
    </div>
    <% } %>

    <div class="mb-4">
      <h4>All Reviews</h4>
      <% if (listing.reviews.length === 0) { %>
        <p class="text-muted">No reviews yet.</p>
      <% } %>
      <% for (let review of listing.reviews) { %>
      <div class="card mb-3">
        <div class="card-body">
          <p class="mb-1"><b>Rating:</b>
            <% for(let i = 1; i <= 5; i++) { %>
              <%= i <= review.rating ? "★" : "☆" %>
            <% } %>
            (<%= review.rating %>/5)
          </p>
          <p class="mb-1"><b>Comment:</b> <%= review.comment %></p>
          <% if (currUser) { %>
          <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-sm btn-dark mt-1">Delete</button>
          </form>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>

  </div>
</div>
